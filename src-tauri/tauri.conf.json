{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdterm",
  "version": "0.1.0",
  "identifier": "com.mdterm.editor",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "[ -d frontend ] && (cd frontend && trunk serve) || (cd ../frontend && trunk serve)",
    "beforeBuildCommand": "[ -d frontend ] && (cd frontend && trunk build --release) || (cd ../frontend && trunk build --release)"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mdterm",
        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#161b22",
        "width": 1300,
        "height": 860,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Terminal emulator with Markdown editor",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop",
        "section": "utils"
      },
      "rpm": {
        "desktopTemplate": "desktop-template.desktop"
      }
    }
  }
}
