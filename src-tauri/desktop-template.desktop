[Desktop Entry]
Categories=System;TerminalEmulator;
GenericName=Terminal Emulator
Keywords=terminal;prompt;shell;command;commandline;cmd;cli;markdown;editor;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec=/usr/bin/{{exec}} %U
StartupWMClass={{name}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=text/markdown;text/x-markdown;
