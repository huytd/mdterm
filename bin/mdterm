#!/usr/bin/env bash
# mdterm CLI: Open Markdown files in mdterm WYSIWYG editor
# Works locally, over SSH, and inside tmux!

set -e

show_help() {
    cat << 'HELP'
mdterm - Open Markdown files in mdterm WYSIWYG editor

USAGE:
    mdterm <file.md>          Open file on the right side (default)
    mdterm --left <file.md>   Open file on the left side (or Super+Click in terminal)
    mdterm -                  Read markdown from stdin and open in editor
    cat file.md | mdterm      Pipe markdown into mdterm editor
    mdterm --setup-remote     Print shell script/function to use on remote SSH servers
    mdterm --help             Show this help message

COMPATIBILITY:
    • Local: Works directly in the mdterm terminal pane
    • SSH: Transmits file content over terminal stream via OSC escape sequences
    • Tmux: Uses tmux DCS passthrough (auto-enables allow-passthrough)
HELP
}

show_remote_setup() {
    cat << 'REMOTE'
# Add this function to your remote machine's ~/.bashrc or ~/.zshrc:
mdterm() {
  local action="open"
  local f=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --left|-l) action="open-left"; shift ;;
      --right) action="open-right"; shift ;;
      *) f="$1"; shift ;;
    esac
  done

  if [ -z "$f" ] || [ "$f" = "-" ]; then
    local content
    content=$(cat)
    local nb64 pb64 cb64
    nb64=$(printf "%s" "stdin.md" | base64 | tr -d '\r\n')
    pb64=$(printf "%s" "stdin.md" | base64 | tr -d '\r\n')
    cb64=$(printf "%s" "$content" | base64 | tr -d '\r\n')
  else
    if [ ! -f "$f" ]; then touch "$f" 2>/dev/null || true; fi
    local nb64 pb64 cb64
    nb64=$(basename "$f" | base64 | tr -d '\r\n')
    pb64=$(realpath "$f" 2>/dev/null || printf "%s" "$f")
    pb64=$(printf "%s" "$pb64" | base64 | tr -d '\r\n')
    cb64=$(base64 "$f" 2>/dev/null | tr -d '\r\n' || true)
  fi

  if [ -n "$TMUX" ]; then
    tmux set -p allow-passthrough on 2>/dev/null || true
    printf "\033Ptmux;\033\033]5337;%s;%s;%s;%s\007\033\\" "$action" "$nb64" "$pb64" "$cb64"
    printf "\033]5337;%s;%s;%s;%s\007" "$action" "$nb64" "$pb64" "$cb64"
  else
    printf "\033]5337;%s;%s;%s;%s\007" "$action" "$nb64" "$pb64" "$cb64"
  fi
  printf "✓ Opened '%s' in mdterm editor\n" "${f:-stdin.md}"
}
REMOTE
}

ACTION="open"
TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --setup-remote)
            show_remote_setup
            exit 0
            ;;
        --left|-l)
            ACTION="open-left"
            shift
            ;;
        --right)
            ACTION="open-right"
            shift
            ;;
        *)
            TARGET="$1"
            shift
            ;;
    esac
done

# Check if input is from pipe or stdin argument
if [ "$TARGET" = "-" ] || [ -z "$TARGET" -a ! -t 0 ]; then
    FILE_NAME="stdin.md"
    FILE_PATH="stdin.md"
    CONTENT=$(cat)
    NAME_B64=$(printf "%s" "$FILE_NAME" | base64 | tr -d '\r\n')
    PATH_B64=$(printf "%s" "$FILE_PATH" | base64 | tr -d '\r\n')
    CONTENT_B64=$(printf "%s" "$CONTENT" | base64 | tr -d '\r\n')
elif [ -n "$TARGET" ]; then
    FILE="$TARGET"
    if [ ! -f "$FILE" ]; then
        touch "$FILE" 2>/dev/null || true
    fi
    FILE_NAME=$(basename "$FILE")
    FILE_PATH=$(realpath "$FILE" 2>/dev/null || printf "%s" "$FILE")
    NAME_B64=$(printf "%s" "$FILE_NAME" | base64 | tr -d '\r\n')
    PATH_B64=$(printf "%s" "$FILE_PATH" | base64 | tr -d '\r\n')
    if [ -f "$FILE" ]; then
        CONTENT_B64=$(base64 "$FILE" 2>/dev/null | tr -d '\r\n' || true)
    else
        CONTENT_B64=""
    fi
else
    show_help
    exit 1
fi

# Transmit escape sequence to terminal
if [ -n "$TMUX" ]; then
    tmux set -p allow-passthrough on 2>/dev/null || true
    tmux set -g allow-passthrough on 2>/dev/null || true
    # Emit DCS passthrough for tmux
    printf "\033Ptmux;\033\033]5337;%s;%s;%s;%s\007\033\\" "$ACTION" "$NAME_B64" "$PATH_B64" "$CONTENT_B64"
    # Also emit direct OSC
    printf "\033]5337;%s;%s;%s;%s\007" "$ACTION" "$NAME_B64" "$PATH_B64" "$CONTENT_B64"
else
    printf "\033]5337;%s;%s;%s;%s\007" "$ACTION" "$NAME_B64" "$PATH_B64" "$CONTENT_B64"
fi

printf "✓ Opened '%s' in mdterm editor\n" "$FILE_NAME"
